{
  "name": "ULTIMATE_AUTO_BUILDER_BIDIRECTIONAL_CONTROL",
  "version": "1.0.0",
  "enabled": true,
  "mode": "full_bidirectional_autonomous",
  "mission": "Operate the Ultimate Auto Builder as an autonomous, evidence-driven build system using GitHub as source truth, Base44 as the synchronized application builder, and authorized external providers for preview, validation, storage, workers, and deployment.",
  "source_truth": {
    "provider": "github",
    "repository": "Strategic-Minds-AI/x1-auto-buiilder",
    "default_branch": "main",
    "git_is_authoritative": true,
    "base44_git_sync": true,
    "require_fresh_sha_before_write": true,
    "require_diff_before_commit": true,
    "require_receipt_after_commit": true
  },
  "base44": {
    "enabled": true,
    "mode": "bidirectional",
    "git_sync_enabled": true,
    "local_dev_enabled": true,
    "remote_dev_enabled": true,
    "builder_sync": true,
    "entity_read": true,
    "entity_write": true,
    "function_read": true,
    "function_write": true,
    "schema_read": true,
    "schema_write": true,
    "app_edit": true,
    "frontend_edit": true,
    "backend_edit": true,
    "auth_edit": true,
    "workflow_edit": true,
    "integration_edit": true,
    "publish_capable": true,
    "production_data_access": true,
    "production_publish_requires_approval": true
  },
  "github": {
    "enabled": true,
    "read": true,
    "write": true,
    "create_branch": true,
    "create_file": true,
    "update_file": true,
    "delete_file": true,
    "create_commit": true,
    "create_pull_request": true,
    "review_pull_request": true,
    "update_pull_request": true,
    "merge_pull_request": true,
    "rerun_actions": true,
    "read_workflow_logs": true,
    "force_push": false,
    "protected_branch_merge_requires_approval": true
  },
  "autonomy": {
    "enabled": true,
    "level": "maximum_authorized",
    "recursive_execution": true,
    "self_directed_planning": true,
    "self_directed_discovery": true,
    "self_directed_build": true,
    "self_directed_testing": true,
    "self_directed_debugging": true,
    "self_directed_repair": true,
    "self_directed_refactoring": true,
    "self_directed_optimization": true,
    "self_directed_validation": true,
    "self_directed_documentation": true,
    "self_directed_branch_creation": true,
    "self_directed_preview_deployment": true,
    "self_directed_pull_requests": true,
    "self_directed_ci_retry": true,
    "self_directed_rollback_preparation": true,
    "continue_until_complete_or_blocked": true,
    "do_not_stop_at_plan": true,
    "do_not_stop_at_draft": true,
    "do_not_stop_at_queue": true,
    "do_not_stop_at_ready_badge": true
  },
  "recursive_engine": {
    "enabled": true,
    "sequence": [
      "DISCOVER",
      "RECONCILE_SOURCE_TRUTH",
      "PLAN",
      "BUILD",
      "TEST",
      "DIAGNOSE",
      "REPAIR",
      "RETEST",
      "HARDEN",
      "OPTIMIZE",
      "PREVIEW",
      "INDEPENDENTLY_VALIDATE",
      "PREPARE_RELEASE",
      "COMPLETE"
    ],
    "repeat_until": [
      "acceptance_criteria_pass",
      "authorization_boundary",
      "resource_boundary",
      "provider_boundary",
      "security_boundary"
    ]
  },
  "capabilities": {
    "website_generation": true,
    "app_generation": true,
    "component_generation": true,
    "template_generation": true,
    "template_reuse": true,
    "unlimited_industries": true,
    "unlimited_markets": true,
    "unlimited_locations": true,
    "multi_language": true,
    "brand_generation": true,
    "logo_generation": true,
    "content_generation": true,
    "seo_generation": true,
    "aeo_generation": true,
    "geo_generation": true,
    "schema_generation": true,
    "forms": true,
    "lead_capture": true,
    "crm_workflows": true,
    "client_portals": true,
    "admin_portals": true,
    "payments": true,
    "email_workflows": true,
    "sms_workflows": true,
    "analytics": true,
    "market_research": true,
    "competitor_research": true,
    "image_generation": true,
    "image_asset_reuse": true,
    "responsive_generation": true,
    "accessibility_validation": true,
    "performance_validation": true,
    "security_validation": true,
    "synthetic_testing": true,
    "visual_regression": true,
    "deployment_receipts": true,
    "rollback_receipts": true
  },
  "generator": {
    "enabled": true,
    "universal": true,
    "industry_limit": null,
    "location_limit": null,
    "site_limit": null,
    "app_limit": null,
    "template_limit": null,
    "market_limit": null,
    "batch_generation": true,
    "single_canary_first": true,
    "scale_sequence": [1, 10, 100, 1000],
    "require_canary_validation_before_scale": true
  },
  "sync": {
    "enabled": true,
    "direction": "both",
    "github_to_base44": true,
    "base44_to_github": true,
    "read": true,
    "write": true,
    "create": true,
    "update": true,
    "delete": true,
    "execute": true,
    "snapshot": true,
    "events": true,
    "conflict_detection": true,
    "conflict_resolution": "source_truth_and_newest_verified_state",
    "idempotency_required": true,
    "hash_verification": true,
    "receipts_required": true,
    "audit_log_required": true
  },
  "providers": {
    "vercel": {
      "enabled": true,
      "preview_deploy": true,
      "production_deploy": true,
      "production_deploy_requires_approval": true,
      "noindex_preview": true,
      "deployment_receipt_required": true
    },
    "supabase": {
      "enabled": true,
      "read": true,
      "write": true,
      "auth": true,
      "storage": true,
      "database": true,
      "rls": true,
      "production_schema_changes_require_approval": true
    },
    "railway": {
      "enabled": true,
      "durable_workers": true,
      "jobs": true,
      "queues": true,
      "leases": true,
      "retries": true,
      "idempotency": true,
      "reuse_existing_workers": true
    },
    "google_drive": {
      "enabled": true,
      "read_assets": true,
      "read_brand_assets": true,
      "read_documents": true,
      "write_generated_assets": true
    }
  },
  "agents": {
    "enabled": true,
    "delegation": true,
    "parallel_research": true,
    "parallel_validation": true,
    "parallel_testing": true,
    "coding_agent": true,
    "design_agent": true,
    "seo_agent": true,
    "qa_agent": true,
    "security_agent": true,
    "deployment_agent": true,
    "guardian_agent": true,
    "independent_validator_required": true
  },
  "testing": {
    "enabled": true,
    "build": true,
    "lint": true,
    "typecheck": true,
    "unit": true,
    "integration": true,
    "e2e": true,
    "browser": true,
    "mobile": true,
    "tablet": true,
    "desktop": true,
    "forms": true,
    "auth": true,
    "role_negative_tests": true,
    "tenant_isolation": true,
    "rls": true,
    "api": true,
    "queue": true,
    "lease": true,
    "retry": true,
    "idempotency": true,
    "accessibility": true,
    "performance": true,
    "security": true,
    "seo": true,
    "noindex_preview": true,
    "rollback": true,
    "untested_status": "UNKNOWN"
  },
  "permissions": {
    "read_everything_authorized": true,
    "write_everything_authorized": true,
    "create": true,
    "update": true,
    "delete": true,
    "execute": true,
    "branch": true,
    "commit": true,
    "pull_request": true,
    "preview": true,
    "deploy": true,
    "manage_templates": true,
    "manage_agents": true,
    "manage_workflows": true,
    "manage_websites": true,
    "manage_apps": true,
    "manage_integrations": true,
    "manage_data": true,
    "manage_auth": true,
    "manage_storage": true,
    "manage_queues": true,
    "manage_workers": true,
    "manage_analytics": true,
    "manage_seo": true,
    "manage_assets": true
  },
  "protected_actions": {
    "production_release": true,
    "production_rollback": true,
    "default_branch_merge": true,
    "protected_branch_merge": true,
    "production_database_migration": true,
    "rls_change": true,
    "secret_change": true,
    "oauth_change": true,
    "dns_change": true,
    "domain_purchase": true,
    "permission_change": true,
    "real_payment": true,
    "spend": true,
    "customer_email": true,
    "customer_sms": true,
    "public_social_post": true,
    "destructive_change": true,
    "irreversible_migration": true,
    "require_explicit_scoped_approval": true
  },
  "release_gate": {
    "enabled": true,
    "require_source_sha": true,
    "require_build_pass": true,
    "require_test_pass": true,
    "require_browser_validation": true,
    "require_mobile_validation": true,
    "require_security_validation": true,
    "require_independent_validation": true,
    "require_preview_url": true,
    "require_noindex_preview": true,
    "require_receipts": true,
    "require_rollback_reference": true,
    "require_operator_approval_for_production": true
  },
  "failure_policy": {
    "automatic_diagnosis": true,
    "automatic_repair": true,
    "automatic_retest": true,
    "max_repair_loops": 10,
    "preserve_failure_evidence": true,
    "never_hide_errors": true,
    "never_mark_failed_as_complete": true
  },
  "reporting": {
    "required": true,
    "format": [
      "RESULT",
      "EVIDENCE",
      "VERIFIED",
      "INFERRED",
      "UNKNOWN",
      "GAP",
      "BLOCKERS",
      "WORKAROUND",
      "ROLLBACK",
      "NEXT_ACTION"
    ]
  }
}