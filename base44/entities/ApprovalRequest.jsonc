{
  "name": "ApprovalRequest",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "Unique approval request identifier (e.g. AR-001)"
    },
    "pipeline_run_id": {
      "type": "string",
      "description": "Linked PipelineRun ID"
    },
    "work_packet_id": {
      "type": "string",
      "description": "Linked WorkPacket ID requiring approval"
    },
    "action_class": {
      "type": "string",
      "enum": [
        "PRODUCTION_RELEASE",
        "BRANCH_MERGE",
        "DB_CHANGE",
        "SECRET_ROTATION",
        "DNS_CHANGE",
        "PAYMENT_SPEND",
        "LIVE_COMMUNICATION",
        "DESTRUCTIVE_ACTION",
        "PERMISSION_ESCALATION"
      ],
      "description": "What class of protected action requires approval"
    },
    "scope": {
      "type": "string",
      "description": "Specific scope of the approval (e.g. 'Deploy to production', 'Merge to main')"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of what is being approved"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "EXPIRED"
      ],
      "default": "PENDING"
    },
    "requested_by": {
      "type": "string",
      "description": "Agent/system that requested the approval"
    },
    "approved_by": {
      "type": "string",
      "description": "User who approved/rejected"
    },
    "approval_reason": {
      "type": "string",
      "description": "Reason for approval or rejection"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this approval request expires if not acted on"
    },
    "rollback_ref": {
      "type": "string",
      "description": "Reference to rollback plan if approved action fails"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "request_id",
    "action_class",
    "scope",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}