{
  "name": "ApprovalRequest",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "approval_type": {
      "type": "string",
      "enum": [
        "design_choice",
        "strategy_choice",
        "release",
        "publishing",
        "provisioning",
        "domain",
        "spending"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "selected_option": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ],
      "default": "pending"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "project_id",
    "approval_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}