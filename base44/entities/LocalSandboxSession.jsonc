{
  "name": "LocalSandboxSession",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Unique session identifier (generated by the local agent)"
    },
    "machine_name": {
      "type": "string",
      "description": "Computer name or label the user assigned"
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "busy"
      ],
      "default": "online",
      "description": "Current connection status"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "shell",
          "filesystem",
          "dev_server",
          "git",
          "npm",
          "docker",
          "python",
          "node"
        ]
      },
      "description": "What this local sandbox can execute"
    },
    "working_dir": {
      "type": "string",
      "description": "Base working directory on the local machine"
    },
    "os": {
      "type": "string",
      "description": "Operating system (win32, darwin, linux)"
    },
    "node_version": {
      "type": "string"
    },
    "last_heartbeat": {
      "type": "string",
      "format": "date-time"
    },
    "last_command_at": {
      "type": "string",
      "format": "date-time"
    },
    "commands_executed": {
      "type": "number",
      "default": 0
    },
    "commands_failed": {
      "type": "number",
      "default": 0
    },
    "current_command_id": {
      "type": "string",
      "description": "Command currently being executed (if busy)"
    },
    "auth_token": {
      "type": "string",
      "description": "Token the local agent uses to authenticate (hashed)"
    }
  },
  "required": [
    "session_id",
    "machine_name",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}