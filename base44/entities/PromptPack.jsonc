{
  "name": "PromptPack",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "What this prompt does and when to use it"
    },
    "industry": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "image_enhancement",
        "template_enhancement",
        "validation",
        "quality_check",
        "website_content",
        "seo_audit",
        "social_content",
        "video_script",
        "email_campaign",
        "ad_copy",
        "brand_voice",
        "competitive_analysis",
        "lead_qualification",
        "estimate_generation"
      ],
      "default": "website_content",
      "description": "Broad category for grouping and filtering"
    },
    "prompt_type": {
      "type": "string",
      "enum": [
        "image_enhancement",
        "template_enhancement",
        "validation",
        "quality_check",
        "website_content",
        "seo_audit",
        "social_content",
        "video_script",
        "email_campaign",
        "ad_copy",
        "brand_voice",
        "competitive_analysis",
        "lead_qualification",
        "estimate_generation"
      ],
      "default": "website_content"
    },
    "system_prompt": {
      "type": "string"
    },
    "user_prompt_template": {
      "type": "string"
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable tags for filtering"
    },
    "model": {
      "type": "string",
      "default": "automatic"
    },
    "response_schema": {
      "type": "object"
    },
    "test_cases": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "usage_count": {
      "type": "number",
      "default": 0,
      "description": "How many times this prompt has been used"
    },
    "rating": {
      "type": "number",
      "description": "0-5 user rating"
    },
    "is_builtin": {
      "type": "boolean",
      "default": false,
      "description": "True for system-provided prompts"
    }
  },
  "required": [
    "name",
    "category",
    "prompt_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.is_builtin": true
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}