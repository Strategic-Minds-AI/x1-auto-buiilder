{
  "name": "PlatformTemplate",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "platform_type": {
      "type": "string",
      "enum": [
        "marketplace",
        "community",
        "directory",
        "membership",
        "education",
        "multi_vendor_commerce",
        "scheduling",
        "creator",
        "agency",
        "franchise",
        "enterprise",
        "aggregator"
      ]
    },
    "industry": {
      "type": "string"
    },
    "architecture": {
      "type": "object",
      "description": "Platform architecture overview"
    },
    "layout": {
      "type": "string"
    },
    "tone": {
      "type": "string"
    },
    "accent": {
      "type": "string"
    },
    "ink": {
      "type": "string"
    },
    "head": {
      "type": "string"
    },
    "sub": {
      "type": "string"
    }
  },
  "required": [
    "template_id",
    "name",
    "platform_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}