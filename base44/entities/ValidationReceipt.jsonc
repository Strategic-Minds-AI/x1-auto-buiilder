{
  "name": "ValidationReceipt",
  "type": "object",
  "properties": {
    "receipt_id": {
      "type": "string",
      "description": "Unique receipt identifier (e.g. VR-001)"
    },
    "pipeline_run_id": {
      "type": "string",
      "description": "Linked PipelineRun ID"
    },
    "work_packet_id": {
      "type": "string",
      "description": "Linked WorkPacket ID being validated"
    },
    "gate": {
      "type": "string",
      "enum": [
        "static",
        "functional",
        "security",
        "visual",
        "operational"
      ],
      "description": "Validation gate type"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "MISSING_EVIDENCE"
      ],
      "default": "MISSING_EVIDENCE",
      "description": "Validation verdict \u2014 PASS requires evidence, never inferred"
    },
    "validator": {
      "type": "string",
      "description": "Independent validator name/agent that performed validation"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Evidence references: URLs, screenshots, test results, benchmark scores"
    },
    "score": {
      "type": "number",
      "description": "0-100 validation score"
    },
    "detail": {
      "type": "string",
      "description": "Detailed validation findings"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "warning",
              "info"
            ]
          },
          "message": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          }
        }
      },
      "description": "Issues found during validation"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "receipt_id",
    "gate",
    "verdict"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}