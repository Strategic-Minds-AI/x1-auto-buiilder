{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Client display name"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe slug (e.g., xps)"
    },
    "parent_organization": {
      "type": "string",
      "description": "Parent organization name"
    },
    "status": {
      "type": "string",
      "enum": [
        "onboarding",
        "researching",
        "active",
        "suspended",
        "churned"
      ],
      "default": "onboarding"
    },
    "website": {
      "type": "string",
      "description": "Client business website URL for automated skip-tracing"
    },
    "industry": {
      "type": "string"
    },
    "brand_color": {
      "type": "string",
      "description": "Brand accent color hex"
    },
    "logo_url": {
      "type": "string"
    },
    "business_research": {
      "type": "object",
      "description": "Auto-populated skip-trace research data (business name, services, service area, tone, competitors)"
    },
    "benchmark": {
      "type": "object",
      "description": "Auto-populated industry benchmark data from research"
    },
    "onboarding_prefill": {
      "type": "object",
      "description": "Pre-filled onboarding payload extracted from automated research"
    },
    "research_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When automated skip-tracing completed"
    },
    "research_error": {
      "type": "string",
      "description": "Error message if automated research failed"
    },
    "supabase_project_ref": {
      "type": "string",
      "description": "Dedicated Supabase project ref for this client"
    },
    "vercel_team_id": {
      "type": "string",
      "description": "Vercel team ID for client deployments"
    },
    "portal_url": {
      "type": "string",
      "description": "Client portal URL slug"
    },
    "config": {
      "type": "object",
      "description": "Client-specific configuration (sandbox, features, etc)"
    }
  },
  "required": [
    "name",
    "slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}