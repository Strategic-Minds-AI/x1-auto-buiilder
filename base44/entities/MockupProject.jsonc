{
  "name": "MockupProject",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name"
    },
    "image_url": {
      "type": "string",
      "description": "Uploaded mock-up image URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "uploaded",
        "scanning",
        "analyzed",
        "generating",
        "generated",
        "operational",
        "failed"
      ],
      "default": "uploaded"
    },
    "analysis": {
      "type": "object",
      "description": "AI analysis: components, layout, colors, typography, sections"
    },
    "component_breakdown": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Pixel-by-pixel component breakdown"
    },
    "generated_code": {
      "type": "string",
      "description": "Generated code from mock-up"
    },
    "preview_url": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "template_type": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "image_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}