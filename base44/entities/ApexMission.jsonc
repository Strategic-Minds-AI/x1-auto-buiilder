{
  "name": "ApexMission",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Mission title"
    },
    "mission_type": {
      "type": "string",
      "enum": [
        "discovery",
        "research",
        "strategy",
        "design",
        "build",
        "test",
        "diagnose",
        "repair",
        "harden",
        "validate",
        "preview",
        "approval",
        "operate",
        "learn",
        "deploy",
        "outreach",
        "measurement",
        "governance"
      ],
      "default": "discovery"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "blocked",
        "complete",
        "failed",
        "cancelled"
      ],
      "default": "pending"
    },
    "priority": {
      "type": "string",
      "enum": [
        "p0",
        "p1",
        "p2",
        "p3"
      ],
      "default": "p1"
    },
    "phase": {
      "type": "string",
      "enum": [
        "phase0",
        "phase1",
        "phase2",
        "phase3",
        "phase4",
        "phase5",
        "phase6",
        "phase7",
        "phase8",
        "phase9",
        "phase10",
        "phase11",
        "phase12"
      ],
      "default": "phase0"
    },
    "assigned_agent": {
      "type": "string",
      "description": "Agent assigned to this mission"
    },
    "description": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "description": "Typed mission inputs"
    },
    "outputs": {
      "type": "object",
      "description": "Typed mission outputs/results"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Mission IDs this depends on"
    },
    "authorization_scope": {
      "type": "string",
      "enum": [
        "safe",
        "protected",
        "production"
      ],
      "default": "safe"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Evidence items: {type, url, description, verified}"
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Execution receipts"
    },
    "cost_estimate": {
      "type": "number"
    },
    "actual_cost": {
      "type": "number"
    },
    "retry_count": {
      "type": "number",
      "default": 0
    },
    "max_retries": {
      "type": "number",
      "default": 3
    },
    "approval_required": {
      "type": "boolean",
      "default": false
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "not_required"
    },
    "rollback_ref": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string",
      "description": "Linked ApexOpportunity ID"
    },
    "project_id": {
      "type": "string",
      "description": "Linked WebsiteProject ID"
    }
  },
  "required": [
    "title",
    "mission_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}