{
  "name": "WebsiteProject",
  "type": "object",
  "properties": {
        "brand_color": { "type": "string", "description": "Primary brand accent color hex" },
        "brand_palette_id": { "type": "string", "description": "Stable selected brand palette id" },
        "brand_palette": { "type": "object", "description": "Full selected brand palette token set" },
        "brand_font": { "type": "string", "description": "Selected typography preset id" }
    "business_name": {
      "type": "string",
      "description": "Business name extracted or entered"
    },
    "business_website": {
      "type": "string",
      "description": "Source business website URL researched"
    },
    "industry": {
      "type": "string",
      "description": "Target industry"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "researching",
        "generated",
        "designing",
        "preview_ready",
        "approved"
      ],
      "default": "draft"
    },
    "business_research": {
      "type": "object",
      "description": "Skip-traced business info from source site"
    },
    "benchmark": {
      "type": "object",
      "description": "Top industry sites + design guidance"
    },
    "content": {
      "type": "object",
      "description": "Generated original website content blueprint"
    },
    "logo_url": {
      "type": "string",
      "description": "AI-generated logo image URL"
    },
    "hero_image_url": {
      "type": "string",
      "description": "AI-generated hero image URL"
    },
    "location": {
      "type": "string",
      "description": "Target location for this variant (mass launch)"
    },
    "campaign_id": {
      "type": "string",
      "description": "LaunchCampaign id this variant belongs to"
    },
    "client_id": {
      "type": "string",
      "description": "Client id this project belongs to (multi-tenant isolation)"
    },
    "deploy_url": {
      "type": "string",
      "description": "Live Vercel deployment URL for this site"
    },
    "deploy_id": {
      "type": "string",
      "description": "Vercel deployment id"
    }
  },
  "required": [
    "business_website",
    "industry"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}