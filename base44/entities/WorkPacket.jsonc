{
  "name": "WorkPacket",
  "type": "object",
  "properties": {
    "packet_id": {
      "type": "string",
      "description": "Unique packet identifier (e.g. WP-001)"
    },
    "pipeline_run_id": {
      "type": "string",
      "description": "Linked PipelineRun ID"
    },
    "stage_id": {
      "type": "string",
      "description": "Which pipeline stage this packet belongs to"
    },
    "title": {
      "type": "string",
      "description": "What this packet accomplishes"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the work"
    },
    "risk_class": {
      "type": "string",
      "enum": [
        "READ",
        "DRAFT",
        "BRANCH_WRITE",
        "PROTECTED"
      ],
      "default": "DRAFT",
      "description": "Risk class: READ (safe), DRAFT (safe), BRANCH_WRITE (needs review), PROTECTED (needs approval)"
    },
    "executor": {
      "type": "string",
      "enum": [
        "BASE44",
        "CODEX",
        "GITHUB_AGENT",
        "VERCEL",
        "SUPABASE",
        "RAILWAY",
        "CLOUD_BROWSER",
        "HUMAN"
      ],
      "default": "BASE44",
      "description": "Which executor should handle this packet"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Packet IDs that must complete before this one can start"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Criteria that must be met for this packet to be considered complete"
    },
    "validation_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What validation gates must pass"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "READY",
        "ASSIGNED",
        "IN_PROGRESS",
        "COMPLETED",
        "FAILED",
        "BLOCKED"
      ],
      "default": "PENDING"
    },
    "assigned_agent": {
      "type": "string",
      "description": "Agent assigned to execute this packet"
    },
    "result": {
      "type": "object",
      "description": "Execution result: {output, url, files, error}"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "References to evidence (receipt IDs, URLs, file URIs)"
    },
    "approval_id": {
      "type": "string",
      "description": "Linked ApprovalRequest ID if risk_class is PROTECTED"
    },
    "retry_count": {
      "type": "number",
      "default": 0
    },
    "max_retries": {
      "type": "number",
      "default": 3
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "packet_id",
    "title",
    "risk_class",
    "executor",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}