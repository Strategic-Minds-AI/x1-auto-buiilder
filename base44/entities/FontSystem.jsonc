{
  "name": "FontSystem",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "heading_font": {
      "type": "string"
    },
    "body_font": {
      "type": "string"
    },
    "display_font": {
      "type": "string"
    },
    "mono_font": {
      "type": "string"
    },
    "scale_ratio": {
      "type": "string",
      "default": "1.25"
    },
    "pairings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "weights": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "licensing": {
      "type": "string"
    },
    "google_fonts_url": {
      "type": "string"
    },
    "preview_text": {
      "type": "string",
      "default": "The quick brown fox jumps over the lazy dog"
    }
  },
  "required": [
    "template_id",
    "name",
    "heading_font",
    "body_font"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}