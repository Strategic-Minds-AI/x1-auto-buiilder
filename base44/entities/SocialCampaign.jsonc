{
  "name": "SocialCampaign",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "brand_manifest_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "facebook",
          "instagram",
          "tiktok",
          "youtube",
          "linkedin",
          "pinterest",
          "twitter",
          "threads",
          "google_business"
        ]
      }
    },
    "start_date": {
      "type": "string",
      "format": "date-time"
    },
    "end_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "publishing",
        "active",
        "paused",
        "completed",
        "failed"
      ],
      "default": "draft"
    },
    "publishing_policy": {
      "type": "string",
      "enum": [
        "manual",
        "auto_approved",
        "paused"
      ],
      "default": "manual"
    },
    "total_posts": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "project_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}