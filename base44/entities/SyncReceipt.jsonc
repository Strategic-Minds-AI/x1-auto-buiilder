{
  "name": "SyncReceipt",
  "type": "object",
  "properties": {
    "receipt_id": {
      "type": "string",
      "description": "Unique receipt id"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Client-supplied idempotency key (empty if none)"
    },
    "action": {
      "type": "string",
      "description": "Sync action: read/create/update/delete/execute/snapshot/events"
    },
    "entity": {
      "type": "string",
      "description": "Entity name or function name operated on"
    },
    "operation": {
      "type": "string",
      "description": "For execute: the function name"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "error",
        "duplicate"
      ],
      "default": "success"
    },
    "record_id": {
      "type": "string",
      "description": "Affected record id, if any"
    },
    "summary": {
      "type": "string",
      "description": "Human-readable summary of the operation"
    }
  },
  "required": [
    "receipt_id",
    "action"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}