{
  "description": "Daily sync of Search Console and GA4 performance data for all deployed projects",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "scheduled_analytics_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_all_analytics": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncAllAnalytics",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sync All Analytics",
            "description": "Iterates all deployed projects and syncs Search Console + GA4 data"
          }
        }
      }
    ]
  },
  "name": "Scheduled Analytics Sync"
}