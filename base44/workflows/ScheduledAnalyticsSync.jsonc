{
  "description": "Daily sync of Search Console and GA4 performance data for all deployed projects",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "scheduled_analytics_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_search_console": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncSearchConsole",
            "args": {}
          },
          "then": "sync_ga4",
          "x-base44": {
            "title": "Sync Search Console",
            "description": "Pull search performance data"
          }
        }
      },
      {
        "sync_ga4": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncGoogleAnalytics",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sync GA4",
            "description": "Pull analytics traffic data"
          }
        }
      }
    ]
  },
  "name": "Scheduled Analytics Sync"
}