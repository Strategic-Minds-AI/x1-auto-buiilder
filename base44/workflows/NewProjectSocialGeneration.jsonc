{
  "name": "New Project Social Generation",
  "description": "When a website project is approved, auto-generate a 30-day social campaign draft",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "WebsiteProject",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"preview_ready\" or .trigger.data.status == \"approved\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "new_project_social_gen",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "generate_social": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateSocialScheduleV2",
            "args": {
              "projectId": "${ .trigger.data.id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Generate 30-Day Social Campaign",
            "description": "Auto-draft social content for approved project"
          }
        }
      }
    ]
  }
}